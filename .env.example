# Copy to .env.local and fill in. Never commit real values.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- WhatsApp Cloud API (Meta) ---
# Any random string; enter the same value in the Meta webhook configuration.
WA_VERIFY_TOKEN=
# Meta app secret (App settings > Basic). Used to verify webhook signatures.
WA_APP_SECRET=
# System-user access token. Leave empty to dry-run outbound messages.
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0
# Dev safety: comma-separated E.164 numbers that may receive messages...
WA_ALLOWLIST=
# ...unless this is exactly "true" (production go-live only).
WA_LIVE=false

# --- Claude (used from day 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
